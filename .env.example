# ==========================================================
# Variaveis de ambiente - Dashboard RAPI 2024-2025
# ==========================================================
#
# Copie este arquivo para `.env` (desenvolvimento local com `netlify dev`)
# e configure o mesmo valor em:
#   Netlify -> Site configuration -> Environment variables
#
# ----------------------------------------------------------
# GEMINI_API_KEY (obrigatoria)
# ----------------------------------------------------------
# Chave da API do Google Gemini usada exclusivamente pela funcao
# serverless `netlify/functions/chat.ts`. Ela NUNCA e exposta ao
# navegador: o frontend conversa apenas com `/api/chat`.
#
# Gere a sua em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# ----------------------------------------------------------
# GEMINI_MODEL (opcional)
# ----------------------------------------------------------
# Sobrescreve o modelo padrao. Se o modelo preview estiver
# indisponivel, a funcao cai automaticamente no fallback seguro.
# Padrao : gemini-3.1-flash-lite-preview
# Fallback: gemini-2.5-flash
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
